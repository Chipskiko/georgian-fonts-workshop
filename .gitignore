# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# workshop runtime artifacts. In local dev the storage adapters write
# here (lib/poster-storage, lib/debug-storage); in production they
# write to Vercel Blob. Keep these dirs out of git so dev experiments
# don't accidentally check in someone's poster or stale debug image.
/public/posters/
/public/debug/

# claude code session state — per-developer, not shared
.claude/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Keep .env.example tracked — documents required env vars for deploy
!.env.example

# vercel
.vercel

# editor swap files
*.swp
*.swo

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Generated specimen GIF (regenerable via scripts/make-specimen-gif.mjs)
specimen-alphabet.gif

# Local-dev font uploads (FS storage adapter). Production uses Vercel Blob.
public/fonts/*
!public/fonts/.gitkeep
