# Copy to .env.local for local development, OR set these as env vars in Vercel.

# Admin password for the /add page (font delete). Defaults to "vividxura"
# if unset. Set this in production so the password isn't in the repo.
ADMIN_PASSWORD=

# Vercel Blob storage token. Automatically injected by Vercel when you
# enable Blob storage on the project — you do NOT need to set this
# manually in the Vercel dashboard if you use the integration.
# Leave empty for local dev (storage falls back to public/fonts/).
BLOB_READ_WRITE_TOKEN=
